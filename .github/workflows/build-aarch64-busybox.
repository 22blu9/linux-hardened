name: Build AArch64 busybox

on:
  workflow_dispatch: {}

  schedule:
    - cron: "21 12 * * 4"

jobs:
  example-job:
    runs-on: ubuntu-24.04-arm
    defaults:
      run:
        working-directory: ./scripts/
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install deps
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential flex bison libssl-dev libelf-dev dwarves pahole rsync bc kmod cpio libncurses-dev wget debootstrap

      - name: Allow exec on kernel
        run: chmod +x build-kernel-aarch64.sh 

      - name: Build kernel
        run: ./build-kernel-aarch64.sh
        
      - name: Allow exec on bootstrap
        run: chmod +x busybox-bootstrap-aarch64.sh
        
      - name: Make bootstrap via script
        run: ./busybox-bootstrap-aarch64.sh


